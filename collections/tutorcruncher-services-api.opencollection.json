{
  "opencollection": "1.0.0",
  "info": {
    "name": "TutorCruncher Agents Services API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
